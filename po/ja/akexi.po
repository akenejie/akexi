#: src/migration/importwizard.cpp:242
msgctxt "@info"
msgid "Database Importing Assistant is about to import <resource>%1</resource> database (connection <resource>%2</resource>) into a KEXI project."
msgstr "データベース取り込みウィザードは、データベース <resource>%1</resource>（接続 <resource>%2</resource>）を KEXI プロジェクトに取り込もうとしています。"

#: src/migration/importwizard.cpp:257
msgctxt "@info"
msgid "Database Importing Assistant is about to import <filename>%1</filename> file of type <resource>%2</resource> into a KEXI project."
msgstr "データベース取り込みウィザードは、種類 <resource>%2</resource> のファイル <filename>%1</filename> を KEXI プロジェクトに取り込もうとしています。"

#: src/migration/importwizard.cpp:263
msgctxt "@info"
msgid "Database Importing Assistant allows you to import an existing database into a KEXI project."
msgstr "データベース取り込みウィザードでは、既存のデータベースを KEXI プロジェクトに取り込むことができます。"

#: src/migration/importwizard.cpp:269
msgctxt "@info"
msgid "<para>Click <interface>Next</interface> button to continue or <interface>Cancel</interface> button to exit this assistant.</para>"
msgstr "<para>続行するには <interface>次へ</interface> ボタンをクリックするか、このウィザードを終了するには <interface>キャンセル</interface> ボタンをクリックしてください。</para>"

#: src/migration/importwizard.cpp:535
msgctxt "@info"
msgid "<para>Following issues were found with the data you entered:</para>%1<para>Please click <interface>Back</interface> button and correct these issues.</para>"
msgstr "<para>入力したデータに以下の問題が見つかりました:</para>%1<para><interface>戻る</interface> ボタンをクリックしてこれらの問題を修正してください。</para>"

#: src/migration/importwizard.cpp:631
msgctxt "@info"
msgid "<para>All required information has now been gathered. Click <interface>Next</interface> button to start importing.</para><para><note>Depending on size of the database this may take some time.</note></para>"
msgstr "<para>必要な情報がすべて集まりました。<interface>次へ</interface> ボタンをクリックして取り込みを開始します。</para><para><note>データベースのサイズによっては時間がかかる場合があります。</note></para>"

#: src/migration/importwizard.cpp:879
msgctxt "@info (don't add tags around %1, it's done already)"
msgid "<para>Database %1 already exists.</para><para>Do you want to replace it with a new one?</para>"
msgstr "<para>データベース %1 は既に存在します。</para><para>新しいものに置き換えますか？</para>"

#: src/migration/importwizard.cpp:926
msgctxt "@info"
msgid "<para>Import failed.</para><para>%1</para><para>%2</para><para>You can click <interface>Back</interface> button and try again.</para>"
msgstr "<para>取り込みに失敗しました。</para><para>%1</para><para>%2</para><para><interface>戻る</interface> ボタンをクリックしてやり直すことができます。</para>"

#: src/migration/importwizard.cpp:971
msgctxt "@info"
msgid "Could not import database <resource>%1</resource>. This type is not supported."
msgstr "データベース <resource>%1</resource> を取り込めませんでした。この種類はサポートされていません。"

#: src/migration/importwizard.cpp:1035
msgctxt "@info"
msgid "Database has been imported into Kexi project <resource>%1</resource>."
msgstr "データベースは Kexi プロジェクト <resource>%1</resource> に取り込まれました。"

#: src/migration/importtablewizard.cpp:126
msgctxt "@info"
msgid "<resource>%1</resource> name is already used by an existing table. Enter different table name to continue."
msgstr "<resource>%1</resource> という名前は既存のテーブルで既に使用されています。続行するには別のテーブル名を入力してください。"

#: src/migration/importtablewizard.cpp:169
msgctxt "@info"
msgid "<para>Table Importing Assistant allows you to import a table from an existing database into the current Kexi project.</para><para>Click <interface>Next</interface> button to continue or <interface>Cancel</interface> button to exit this assistant.</para>"
msgstr "<para>テーブル取り込みウィザードでは、既存のデータベースからテーブルを現在の KEXI プロジェクトに取り込むことができます。</para><para>続行するには <interface>次へ</interface> ボタンをクリックするか、このウィザードを終了するには <interface>キャンセル</interface> ボタンをクリックしてください。</para>"

#: src/migration/importtablewizard.cpp:466
#: src/migration/importtablewizard.cpp:480
msgctxt "@info"
msgid "Could not import table <resource>%1</resource>. Select different table or cancel importing."
msgstr "テーブル <resource>%1</resource> を取り込めませんでした。別のテーブルを選択するか、取り込みをキャンセルしてください。"

#: src/migration/importtablewizard.cpp:498
msgctxt "@info"
msgid "No data has been found in table <resource>%1</resource>. Select different table or cancel importing."
msgstr "テーブル <resource>%1</resource> にデータが見つかりませんでした。別のテーブルを選択するか、取り込みをキャンセルしてください。"

#: src/migration/importtablewizard.cpp:522
msgctxt "@info Table import wizard, final message"
msgid "<para>All required information has now been gathered. Click <interface>Next</interface> button to start importing table <resource>%1</resource>.</para><para><note>Depending on size of the table this may take some time.</note></para>"
msgstr "<para>必要な情報がすべて集まりました。<interface>次へ</interface> ボタンをクリックしてテーブル <resource>%1</resource> の取り込みを開始します。</para><para><note>テーブルのサイズによっては時間がかかる場合があります。</note></para>"

#: src/migration/importtablewizard.cpp:576
msgctxt "@info"
msgid "Table <resource>%1</resource> has been imported."
msgstr "テーブル <resource>%1</resource> は取り込まれました。"

#: src/migration/importtablewizard.cpp:726
msgctxt "@info"
msgid "Unable to create table <resource>%1</resource>."
msgstr "テーブル <resource>%1</resource> を作成できません。"

